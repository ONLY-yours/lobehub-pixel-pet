{
  "name": "pixel-pet",
  "version": "0.2.1",
  "description": "A pixel-art desktop pet powered by a LobeHub agent",
  "main": "src/main/main.js",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/*.test.js\"",
    "e2e": "node e2e/run.js",
    "icon": "node scripts/make-icon.js",
    "dist:mac": "electron-builder --mac --universal --publish never",
    "dist:win": "electron-builder --win --x64 --publish never"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "playwright": "^1.64.0"
  },
  "author": {
    "name": "LiJian",
    "email": "onlyyoulove3@gmail.com"
  },
  "homepage": "https://github.com/ONLY-yours/lobehub-pixel-pet",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ONLY-yours/lobehub-pixel-pet.git"
  },
  "build": {
    "appId": "com.onlyyours.pixelpet",
    "productName": "Pixel Pet",
    "copyright": "Copyright © LiJian",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "mac": {
      "category": "public.app-category.entertainment",
      "target": [
        {
          "target": "dmg"
        },
        {
          "target": "zip"
        }
      ],
      "icon": "build/icon.png",
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "artifactName": "PixelPet-${version}-mac-${arch}.${ext}"
    },
    "dmg": {
      "title": "Pixel Pet ${version}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "PixelPet-${version}-win-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "PixelPet-${version}-win-${arch}-setup.${ext}"
    }
  },
  "bugs": {
    "url": "https://github.com/ONLY-yours/lobehub-pixel-pet/issues"
  }
}
